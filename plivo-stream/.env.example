# --- Bridge server ---
PORT=8000

# Public hostname Plivo reaches this server on, WITHOUT a scheme.
# With ngrok: PUBLIC_HOST=abc123.ngrok-free.app
# Leave unset to use the Host header (fine locally, unreliable behind proxies).
PUBLIC_HOST=

# From the Plivo console. When set, every incoming stream's V3 signature is
# verified. Leave unset only for local experiments.
PLIVO_AUTH_TOKEN=

# Spoken by Plivo before the stream opens. Leave blank to let the agent greet.
GREETING=

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Telephony is 8 kHz; change only if your Plivo app streams something else.
TELEPHONY_SAMPLE_RATE=8000
