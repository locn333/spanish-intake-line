# Must point at the same LiveKit project as the bridge.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speko Platform API key (sk_live_...). Speko routes STT/LLM/TTS per call, so no
# provider keys are needed here.
SPEKO_API_KEY=
SPEKO_BASE_URL=https://api.speko.dev

# Spoken by the agent in its greeting.
BUSINESS_NAME=

# --- How messages reach you ---

# Email is the primary channel and needs no carrier registration.
# SMTP_URL examples:
#   smtps://user:pass@smtp.gmail.com:465        (Gmail app password)
#   smtp://apikey:SG.xxxx@smtp.sendgrid.net:587 (SendGrid)
SMTP_URL=
OWNER_EMAIL=
MAIL_FROM=recados@yourdomain.com

# --- SMS (optional, off unless configured) ---

# Text yourself a short alert in addition to the email.
OWNER_SMS_NUMBER=

# Plivo credentials for sending SMS. Separate from the voice bridge.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SMS_FROM=

# Texting the CUSTOMER back requires A2P 10DLC registration with the carriers.
# Until that is approved, unregistered messages are filtered or silently
# dropped. Leave this false until your campaign is live.
SMS_10DLC_READY=false
